# Supabase Postgres connection - the app uses the pooler, Prisma Migrate/CLI uses the direct one.
# Both come from Supabase: Project Settings > Database > Connection string.

# Transaction pooler (port 6543) - used by the running app at runtime
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - used only by `npx prisma migrate` / `db seed`
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Secret used to sign JWTs - generate a long random string for production
JWT_SECRET="replace-this-with-a-long-random-secret"

PORT=4000

# Filled in later when Razorpay integration is wired up
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
