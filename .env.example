# Supabase Postgres connection (transaction pooler, port 6543 - matches CatalystIQ pattern)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Secret used to sign JWTs - generate a long random string for production
JWT_SECRET="replace-this-with-a-long-random-secret"

PORT=4000

# Filled in later when Razorpay integration is wired up
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
