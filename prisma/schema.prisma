// KKSDENTAL Lab - Database Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // transaction pooler (port 6543) - used by the running app
  directUrl = env("DIRECT_URL") // direct connection (port 5432) - used by Prisma CLI/migrations
}

enum Role {
  ADMIN
  LAB_STAFF
  DENTIST
}

enum DeliveryStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  RETURN_REPEAT
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum TransactionType {
  PAYMENT
  ADJUSTMENT
}

enum TransactionMethod {
  CASH
  UPI
}
enum AdPlacement {
  HERO
  SHOP
}

// Every login (admin, lab staff, or dentist/clinic) is a User.
// Dentist/clinic users have an attached Clinic profile with business details.
model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  username        String          @unique
  passwordHash    String
  role            Role
  pushToken       String?
  clinic          Clinic?
  loginActivities LoginActivity[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Clinic {
  id            String        @id @default(uuid())
  name          String
  contactPerson String
  email         String
  phone         String
  address       String
  active        Boolean       @default(true)
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id])
  patients      Patient[]
  cases         Case[]
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
}

model Advertisement {
  id        String      @id @default(uuid())
  imageData String      @db.Text
  link      String?
  placement AdPlacement @default(HERO)
  createdAt DateTime    @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  imageData   String?  @db.Text
  link        String?
  phone       String?
  createdAt   DateTime @default(now())
}

model Patient {
  id          String   @id @default(uuid())
  patientCode String   @unique // e.g. PT-013
  fullName    String
  gender      String
  age         Int
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  cases       Case[]
  createdAt   DateTime @default(now())
}

// --- Admin-managed catalog (Services & Pricing, under Account Settings) ---

model Service {
  id           String           @id @default(uuid())
  name         String           @unique // e.g. Crown, Bridge, Denture, Night Guard
  serviceTypes ServiceType[]
  priceEntries PriceListEntry[]
  cases        Case[]
}

// A ServiceType (e.g. "ALL CERAMIC", "PFM", "METAL" under Crown) can use
// EITHER the classic single-price flow (via PriceListEntry + Warranty,
// original two-level system) OR the newer Subtype+ServiceTypeWarranty
// flow, OR the step-based flow (usesSteps) - whichever fits that service.
model ServiceType {
  id             String                @id @default(uuid())
  name           String
  usesSteps      Boolean               @default(false)
  serviceId      String
  service        Service               @relation(fields: [serviceId], references: [id])
  priceEntries   PriceListEntry[]
  cases          Case[]
  subtypes       ServiceSubtype[]
  typeWarranties ServiceTypeWarranty[]
  steps          ServiceStep[]
}

// Sits under a ServiceType (e.g. "Premium Zirconia" under "ALL CERAMIC")
model ServiceSubtype {
  id            String              @id @default(uuid())
  name          String
  serviceTypeId String
  serviceType   ServiceType         @relation(fields: [serviceTypeId], references: [id])
  priceEntries  SubtypePriceEntry[]
  cases         Case[]
}

// Warranty options scoped to ONE specific Service Type (not shared/global) -
// e.g. ALL CERAMIC has its own 5/10/15 Year options, PFM has its own 3/5
// Year options, METAL has none at all.
model ServiceTypeWarranty {
  id            String              @id @default(uuid())
  label         String
  serviceTypeId String
  serviceType   ServiceType         @relation(fields: [serviceTypeId], references: [id])
  priceEntries  SubtypePriceEntry[]
  cases         Case[]
}

// The actual price for a Subtype x Warranty combination.
// serviceTypeWarrantyId is optional - Service Types with no warranty (like
// METAL) just price by subtype alone.
model SubtypePriceEntry {
  id                    String               @id @default(uuid())
  serviceSubtypeId      String
  serviceTypeWarrantyId String?
  price                 Decimal              @db.Decimal(10, 2)
  serviceSubtype        ServiceSubtype       @relation(fields: [serviceSubtypeId], references: [id])
  serviceTypeWarranty   ServiceTypeWarranty? @relation(fields: [serviceTypeWarrantyId], references: [id])

  @@unique([serviceSubtypeId, serviceTypeWarrantyId])
}

// Individual priced steps for step-based Service Types (Complete Denture
// etc.) - e.g. "Special Tray", "Teeth Setting per Arch". A case using this
// ServiceType picks one or more steps; the total is their sum.
model ServiceStep {
  id            String      @id @default(uuid())
  name          String
  price         Decimal     @db.Decimal(10, 2)
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  caseSteps     CaseStep[]
}

// Records which steps were picked for a specific order, with price
// snapshotted at order time (so later price changes don't rewrite history).
model CaseStep {
  id            String      @id @default(uuid())
  caseId        String
  case          Case        @relation(fields: [caseId], references: [id])
  serviceStepId String
  serviceStep   ServiceStep @relation(fields: [serviceStepId], references: [id])
  name          String
  price         Decimal     @db.Decimal(10, 2)
}

// Original global warranty list - kept for backward compatibility with
// existing Service/ServiceType combinations that don't use the newer
// per-Service-Type warranty system.
model Warranty {
  id           String           @id @default(uuid())
  label        String           @unique // e.g. "6 Months", "1 Year", "Lifetime"
  priceEntries PriceListEntry[]
  cases        Case[]
}

model ToothShade {
  id    String @id @default(uuid())
  code  String @unique // e.g. A1, A2, B1
  cases Case[]
}

model PriceListEntry {
  id            String      @id @default(uuid())
  serviceId     String
  serviceTypeId String
  warrantyId    String
  price         Decimal     @db.Decimal(10, 2)
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  warranty      Warranty    @relation(fields: [warrantyId], references: [id])

  @@unique([serviceId, serviceTypeId, warrantyId])
}

// --- Core case/order record ---

model Case {
  id             String         @id @default(uuid())
  caseCode       String         @unique // e.g. ORD-0042
  patientId      String
  clinicId       String
  serviceId      String
  serviceTypeId  String
  warrantyId     String?
  toothShadeId   String?
  toothNumbers   String[] // FDI two-digit codes, e.g. ["11","12","21"]
  comment        String?        @db.Text
  pickedUpAt     DateTime?
  photos         CasePhoto[]
  quantity       Int
  unitPrice      Decimal        @db.Decimal(10, 2)
  totalPrice     Decimal        @db.Decimal(10, 2)
  deliveryStatus DeliveryStatus @default(PENDING)
  paymentStatus  PaymentStatus  @default(UNPAID)
  createdById    String

  serviceSubtypeId      String?
  serviceSubtype        ServiceSubtype?      @relation(fields: [serviceSubtypeId], references: [id])
  serviceTypeWarrantyId String?
  serviceTypeWarranty   ServiceTypeWarranty? @relation(fields: [serviceTypeWarrantyId], references: [id])
  caseSteps             CaseStep[]

  patient      Patient       @relation(fields: [patientId], references: [id])
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  serviceType  ServiceType   @relation(fields: [serviceTypeId], references: [id])
  warranty     Warranty?     @relation(fields: [warrantyId], references: [id])
  toothShade   ToothShade?   @relation(fields: [toothShadeId], references: [id])
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CasePhoto {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  imageData String   @db.Text
  createdAt DateTime @default(now())
}

// --- Financial ledger: one continuous account per clinic ---
// Powers Clinic-wise Invoices (client), Invoice tab (admin), and
// Manage Clinics > Account Summary (admin) - all read from this table.
model Transaction {
  id          String             @id @default(uuid())
  clinicId    String
  caseId      String? // optional link to the specific case being paid off
  amount      Decimal            @db.Decimal(10, 2)
  type        TransactionType
  method      TransactionMethod?
  remarks     String?
  createdById String

  clinic Clinic @relation(fields: [clinicId], references: [id])
  case   Case?  @relation(fields: [caseId], references: [id])

  createdAt DateTime @default(now())
}

// --- Login activity for the Security screen ---
model LoginActivity {
  id         String   @id @default(uuid())
  userId     String
  ipAddress  String?
  deviceInfo String? // e.g. "android", "ios" - sent by the app at login time
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

// --- Gallery & Blog: lab-side marketing content ---
// Photos stored as base64 directly in the row (simple setup, fine at this
// scale) rather than an external object store - revisit if the gallery
// grows large enough that this becomes a performance concern.
model GalleryPhoto {
  id           String   @id @default(uuid())
  imageData    String   @db.Text
  caption      String?
  uploadedById String
  createdAt    DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  imageData String?  @db.Text
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Admin/lab-staff notification feed (new orders, payments) ---
// Read/unread is tracked globally, not per-user - fine for a small team
// where anyone marking it read means it's been seen.
model Notification {
  id        String   @id @default(uuid())
  type      String // "NEW_ORDER" | "PAYMENT"
  message   String
  caseId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}